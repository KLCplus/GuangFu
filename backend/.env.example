# =========================================================
# 光伏平台后端 - 环境变量模板
# 复制此文件为 .env ，填入实际值后启动
# .env 已在 .gitignore 中排除，不要提交到 Git
# =========================================================

# ---- JWT（必须配置） ----
JWT_SECRET=至少32个字符的随机字符串-替换为你自己的

# ---- 数据库 ----
MYSQL_URL=jdbc:mysql://localhost:3306/pv_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=你的数据库密码

# ---- GitHub OAuth（可选） ----
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=你的GitHub_OAuth_App_Client_ID
OAUTH_GITHUB_CLIENT_SECRET=你的GitHub_OAuth_App_Client_Secret
OAUTH_CALLBACK_BASE_URL=http://localhost:5173

# ---- 阿里云人脸识别（可选） ----
FACE_PROVIDER=local
ALIYUN_ACCESS_KEY_ID=你的阿里云AccessKeyId
ALIYUN_ACCESS_KEY_SECRET=你的阿里云AccessKeySecret
ALIYUN_FACE_REGION=cn-shanghai
ALIYUN_FACE_ENDPOINT=facebody.cn-shanghai.aliyuncs.com
ALIYUN_FACE_DB_NAME=pv_platform
ALIYUN_OSS_REGION=cn-shanghai
ALIYUN_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_BUCKET=你的OSS_Bucket名称
FACE_MATCH_THRESHOLD=75
FACE_TEMP_URL_EXPIRE_SECONDS=300

# ---- QQ 邮箱验证码（可选） ----
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=你的QQ号@qq.com
MAIL_PASSWORD=你的QQ邮箱授权码
MAIL_FROM=你的QQ号@qq.com
MAIL_SSL_ENABLED=true
