<view class="page profile-page">
  <view class="profile-heading"><text>我的</text><text>账户资料与平台服务</text></view>
  <view wx:if="{{!loggedIn}}" class="guest-shell">
    <view class="guest-orbit"><view></view><text>光</text></view>
    <text class="guest-title">管理你的平台账户</text>
    <text class="guest-copy">登录后查看资料、余额、API Key 与模型权益。</text>
    <button class="button-primary guest-button" bindtap="goLogin">连接平台账号</button>
    <text class="guest-note">使用现有用户名和密码，小程序不会保存密码。</text>
  </view>

  <block wx:else>
    <view class="identity-card" bindtap="goProfile">
      <view class="sun-track"><view></view><view></view><view></view></view>
      <view class="identity-main">
        <view class="avatar-shell">
          <image wx:if="{{user && user.avatarUrl && !avatarFailed}}" src="{{user.avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
          <text wx:else>{{user ? user.avatarText : '光'}}</text>
        </view>
        <view class="identity-copy">
          <text class="identity-name">{{user ? user.displayName : '正在读取账户'}}</text>
          <text class="identity-secondary">{{user ? user.secondaryText : '请稍候'}}</text>
          <view wx:if="{{user}}" class="identity-tags">
            <text class="status-pill {{user.statusNormal ? 'normal' : 'limited'}}">{{user.statusText}}</text>
            <text class="status-pill email">{{user.emailStatus}}</text>
          </view>
        </view>
        <text class="identity-arrow">›</text>
      </view>
      <view wx:if="{{profileError}}" class="inline-error"><text>{{profileError}}</text><text catchtap="loadAccount">重试</text></view>
    </view>

    <view class="metrics-card">
      <view bindtap="goWallet"><text class="metric-value">{{metrics.balance}}</text><text class="metric-label">可用余额</text><text wx:if="{{metricErrors.balance}}" class="metric-error">加载失败</text></view>
      <view bindtap="goEntitlements"><text class="metric-value">{{metrics.keyCount}}</text><text class="metric-label">API Key</text><text wx:if="{{metricErrors.keys}}" class="metric-error">加载失败</text></view>
      <view bindtap="goEntitlements"><text class="metric-value">{{metrics.entitlementCount}}</text><text class="metric-label">API 权益</text><text wx:if="{{metricErrors.entitlements}}" class="metric-error">加载失败</text></view>
    </view>

    <view class="section-head"><text class="section-title">账户功能</text><text wx:if="{{loading}}" class="loading-text">正在同步</text></view>
    <view class="menu-card">
      <view class="menu-row" bindtap="goProfile"><text class="menu-mark blue">资</text><view><text>个人资料</text><text>头像、昵称与联系方式</text></view><text class="menu-arrow">›</text></view>
      <view class="menu-row" bindtap="goSecurity"><text class="menu-mark green">安</text><view><text>安全与登录</text><text>修改密码与绑定状态</text></view><text class="menu-arrow">›</text></view>
      <view class="menu-row" bindtap="goWallet"><text class="menu-mark amber">钱</text><view><text>钱包与消费</text><text>余额与最近资金变动</text></view><text class="menu-arrow">›</text></view>
      <view class="menu-row" bindtap="goEntitlements"><text class="menu-mark violet">权</text><view><text>API 权益</text><text>Key 状态、额度与有效期</text></view><text class="menu-arrow">›</text></view>
    </view>

    <button class="logout-button" bindtap="logout">退出登录</button>
    <view class="safe-space"></view>
  </block>
</view>
