.profile-hero{display:flex;align-items:center;gap:24rpx;margin:-28rpx -28rpx 28rpx;padding:48rpx 34rpx;background:linear-gradient(145deg,#0b4eaa,#1677ff);color:#fff}.avatar{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;border:2rpx solid rgba(255,255,255,.34);border-radius:34rpx;background:rgba(255,255,255,.16);font-size:42rpx;font-weight:800}.identity text{display:block}.identity text:first-child{font-size:34rpx;font-weight:750}.identity text:last-child{margin-top:8rpx;font-size:22rpx;opacity:.72}.connect-title,.connect-copy{display:block}.connect-title{font-size:31rpx;font-weight:750}.connect-copy{margin:12rpx 0 26rpx;color:#6f7f96;font-size:24rpx}.connect-card button{width:100%}.info-card{padding-top:8rpx;padding-bottom:8rpx}.info-card>view{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid #edf2f7}.info-card>view:last-child{border:0}.info-card>view>text:first-child{color:#6f7f96}.base-url{max-width:430rpx;overflow:hidden;color:#40546d;font-family:monospace;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.profile-error{display:flex;justify-content:space-between;margin-bottom:18rpx;color:#df4b5f}.profile-error text:last-child{color:#1677ff}.roadmap-card{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx}.roadmap-card view text{display:block}.roadmap-card view text:first-child{font-weight:700}.roadmap-card view text:last-child{margin-top:9rpx;color:#7c8ca1;font-size:22rpx}.roadmap-card>text{color:#9aa7b7;font-size:40rpx}.logout-button{margin-top:28rpx;background:transparent;color:#df4b5f;font-size:26rpx}.logout-button::after{border-color:#efd5da;border-radius:18rpx}.scope-note{margin-top:42rpx;padding:0 10rpx;color:#8593a6;font-size:22rpx;line-height:1.7}.scope-note text{display:block}.scope-note text:first-child{margin-bottom:5rpx;color:#53667e;font-weight:700}
