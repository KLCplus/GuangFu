.profile-page{padding-bottom:calc(52rpx + env(safe-area-inset-bottom))}.guest-shell{display:flex;align-items:center;flex-direction:column;padding:112rpx 34rpx 50rpx;text-align:center}.guest-orbit{position:relative;display:flex;align-items:center;justify-content:center;width:136rpx;height:136rpx;margin-bottom:38rpx;border-radius:44rpx;background:linear-gradient(145deg,#0d5fc5,#48a2ff);box-shadow:0 22rpx 55rpx rgba(22,119,255,.24);color:#fff;font-size:52rpx;font-weight:800}.guest-orbit>view{position:absolute;width:112rpx;height:42rpx;border:2rpx solid rgba(255,255,255,.48);border-radius:50%;transform:rotate(-28deg)}.guest-title{font-size:38rpx;font-weight:800}.guest-copy{max-width:530rpx;margin:16rpx 0 34rpx;color:#6f7f96;font-size:25rpx;line-height:1.7}.guest-button{width:100%;max-width:520rpx}.guest-note{margin-top:24rpx;color:#95a2b2;font-size:21rpx}.identity-card{position:relative;overflow:hidden;margin:-28rpx -28rpx 0;padding:52rpx 34rpx 42rpx;background:linear-gradient(145deg,#0b4eaa,#1677ff 70%,#3398ff);color:#fff}.sun-track{position:absolute;right:-28rpx;top:-42rpx;width:260rpx;height:150rpx;opacity:.22}.sun-track view{position:absolute;border:2rpx solid #fff;border-radius:50%}.sun-track view:nth-child(1){inset:0}.sun-track view:nth-child(2){inset:26rpx}.sun-track view:nth-child(3){inset:52rpx}.identity-main{position:relative;display:flex;align-items:center;gap:22rpx}.avatar-shell{display:flex;align-items:center;justify-content:center;flex:none;width:106rpx;height:106rpx;overflow:hidden;border:3rpx solid rgba(255,255,255,.38);border-radius:36rpx;background:rgba(255,255,255,.17);font-size:42rpx;font-weight:800}.avatar-shell image{width:100%;height:100%}.identity-copy{min-width:0;flex:1}.identity-copy>text{display:block}.identity-name{overflow:hidden;font-size:35rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.identity-secondary{overflow:hidden;margin-top:7rpx;font-size:22rpx;opacity:.78;text-overflow:ellipsis;white-space:nowrap}.identity-tags{display:flex;flex-wrap:wrap;gap:9rpx;margin-top:15rpx}.status-pill{padding:7rpx 13rpx;border-radius:999rpx;background:rgba(255,255,255,.14);font-size:19rpx}.status-pill.normal{background:rgba(70,224,157,.2)}.status-pill.limited{background:rgba(255,174,74,.23)}.identity-arrow{font-size:42rpx;opacity:.72}.inline-error{position:relative;display:flex;justify-content:space-between;gap:18rpx;margin-top:24rpx;padding:16rpx 18rpx;border-radius:14rpx;background:rgba(91,15,25,.2);font-size:21rpx}.inline-error text:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.inline-error text:last-child{flex:none;font-weight:700}.metrics-card{display:grid;grid-template-columns:repeat(3,1fr);margin:-2rpx -2rpx 0;padding:28rpx 8rpx 26rpx;border-radius:0 0 26rpx 26rpx;background:#fff;box-shadow:0 14rpx 36rpx rgba(35,87,145,.08)}.metrics-card>view{min-width:0;padding:0 10rpx;text-align:center}.metrics-card>view+view{border-left:1rpx solid #e8eef6}.metric-value,.metric-label,.metric-error{display:block}.metric-value{overflow:hidden;color:#172033;font-size:29rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.metric-label{margin-top:8rpx;color:#728198;font-size:21rpx}.metric-error{margin-top:5rpx;color:#df4b5f;font-size:18rpx}.loading-text{color:#7d8da3;font-size:21rpx}.menu-card{overflow:hidden;border-radius:24rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(35,87,145,.06)}.menu-row{display:flex;align-items:center;gap:20rpx;min-height:116rpx;padding:18rpx 24rpx;box-sizing:border-box}.menu-row+.menu-row{position:relative}.menu-row+.menu-row::before{position:absolute;top:0;right:24rpx;left:92rpx;height:1rpx;background:#edf2f7;content:""}.menu-mark{display:flex;align-items:center;justify-content:center;flex:none;width:54rpx;height:54rpx;border-radius:18rpx;font-size:22rpx;font-weight:800}.menu-mark.blue{background:#e9f3ff;color:#1677ff}.menu-mark.green{background:#e8f8f1;color:#159366}.menu-mark.amber{background:#fff3de;color:#c77b08}.menu-mark.violet{background:#f1edff;color:#6d55c7}.menu-row>view{min-width:0;flex:1}.menu-row>view text{display:block}.menu-row>view text:first-child{font-size:27rpx;font-weight:700}.menu-row>view text:last-child{overflow:hidden;margin-top:7rpx;color:#7b899d;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.menu-arrow{color:#a2adbb;font-size:40rpx}.logout-button{margin-top:30rpx;background:#fff;color:#d7485b;font-size:26rpx}.logout-button::after{border:0}.safe-space{height:16rpx}

