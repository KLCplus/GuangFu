.article-page{padding-top:38rpx;background:#fff}.article{max-width:680rpx;margin:0 auto}.article-type{display:inline-block;padding:8rpx 15rpx;border-radius:999rpx;background:#eaf3ff;color:#1677ff;font-size:21rpx;font-weight:700}.article-title,.article-time,.article-summary{display:block}.article-title{margin:22rpx 0 17rpx;font-size:43rpx;font-weight:800;line-height:1.35}.article-time{color:#8b98aa;font-size:22rpx}.article-cover{width:100%;height:330rpx;margin-top:30rpx;border-radius:24rpx}.article-summary{margin:30rpx 0;padding:24rpx;border-left:6rpx solid #1677ff;background:#f5f9fe;color:#4f627a;font-size:25rpx;line-height:1.75}.article-body{width:100%;margin-top:32rpx;color:#34455c;font-size:28rpx;line-height:1.95}.article-rich{display:block;min-width:100%;overflow-wrap:anywhere}.article-empty{margin-top:30rpx;padding:26rpx;border-radius:18rpx;background:#f7f9fc;color:#8190a3;text-align:center;font-size:23rpx}.article-loading{height:440rpx}
.warning-panel{display:flex;flex-direction:column;gap:8rpx;margin-top:24rpx;padding:22rpx;border-radius:18rpx;background:#fff7ed;color:#93561a;font-size:22rpx;line-height:1.6}.warning-panel text:first-child{font-weight:700}.original-button{margin:38rpx 0 calc(28rpx + env(safe-area-inset-bottom));border:0;border-radius:18rpx;background:#eaf3ff;color:#1677ff;font-size:25rpx}.original-button::after{border:0}
.attachment-card{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:30rpx;padding:22rpx;border-radius:18rpx;background:#f2f7fc}.attachment-card view{min-width:0;flex:1}.attachment-card text{display:block;overflow-wrap:anywhere;color:#1b3f65;font-size:24rpx}.attachment-card text:first-child{margin-bottom:7rpx;color:#718096;font-size:20rpx}.attachment-card button{flex:none;margin:0;padding:0 18rpx;border:0;background:#e3effb;color:#1677ff;font-size:21rpx;line-height:62rpx}.attachment-card button::after{border:0}
