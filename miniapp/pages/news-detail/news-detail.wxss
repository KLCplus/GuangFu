.article-page{padding-top:38rpx;background:#fff}.article{max-width:680rpx;margin:0 auto}.article-type{display:inline-block;padding:8rpx 15rpx;border-radius:999rpx;background:#eaf3ff;color:#1677ff;font-size:21rpx;font-weight:700}.article-title,.article-time,.article-summary,.article-body text{display:block}.article-title{margin:22rpx 0 17rpx;font-size:43rpx;font-weight:800;line-height:1.35}.article-time{color:#8b98aa;font-size:22rpx}.article-cover{width:100%;height:330rpx;margin-top:30rpx;border-radius:24rpx}.article-summary{margin:30rpx 0;padding:24rpx;border-left:6rpx solid #1677ff;background:#f5f9fe;color:#4f627a;font-size:25rpx;line-height:1.75}.article-body{margin-top:32rpx}.article-body text{margin-bottom:25rpx;color:#34455c;font-size:28rpx;line-height:1.95}.article-loading{height:440rpx}
.warning-panel{display:flex;flex-direction:column;gap:8rpx;margin-top:24rpx;padding:22rpx;border-radius:18rpx;background:#fff7ed;color:#93561a;font-size:22rpx;line-height:1.6}.warning-panel text:first-child{font-weight:700}.original-button{margin:38rpx 0 calc(28rpx + env(safe-area-inset-bottom));border:0;border-radius:18rpx;background:#eaf3ff;color:#1677ff;font-size:25rpx}.original-button::after{border:0}
