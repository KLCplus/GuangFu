.wallet-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.wallet-skeleton{height:350rpx}.balance-card{display:flex;align-items:flex-end;justify-content:space-between;gap:30rpx;padding:34rpx;border:1rpx solid #dce6f1;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(31,61,98,.04)}.balance-label,.balance-value{display:block}.balance-label{color:#718198;font-size:22rpx}.balance-value{margin-top:10rpx;color:#1768b8;font-size:48rpx;font-weight:800}.balance-grid{display:grid;grid-template-columns:1fr 1fr;min-width:310rpx}.balance-grid view+view{padding-left:24rpx;border-left:1rpx solid #e5ebf2}.balance-grid text{display:block}.balance-grid text:first-child{color:#8290a2;font-size:19rpx}.balance-grid text:last-child{margin-top:7rpx;color:#26364c;font-size:25rpx;font-weight:700}.section-caption{color:#8996a6;font-size:21rpx}.recharge-card{border:1rpx solid #e1e8f0;box-shadow:none}.test-notice{display:flex;align-items:flex-start;gap:18rpx;padding:20rpx;border-radius:17rpx;background:#f2f7fd}.test-notice>text{flex:none;padding:6rpx 11rpx;border-radius:999rpx;background:#dcecff;color:#1768b8;font-size:18rpx}.test-notice view text{display:block}.test-notice view text:first-child{color:#26364c;font-size:23rpx;font-weight:700}.test-notice view text:last-child{margin-top:6rpx;color:#708198;font-size:19rpx;line-height:1.55}.amount-label{display:block;margin:28rpx 0 14rpx;color:#4e6078;font-size:22rpx;font-weight:700}.amount-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.amount-chip{padding:19rpx 8rpx;border:1rpx solid #dfe6ee;border-radius:15rpx;background:#fff;color:#465a72;font-size:24rpx;font-weight:700;text-align:center}.amount-chip.selected{border-color:#7eb4ee;background:#eaf3ff;color:#1265b5}.custom-amount{display:flex;align-items:center;margin-top:14rpx;padding:0 20rpx;border:1rpx solid #dfe6ee;border-radius:16rpx;background:#f7f9fc}.custom-amount>text{color:#63758c;font-size:26rpx}.custom-amount input{height:78rpx;margin-left:12rpx;flex:1;font-size:25rpx}.recharge-button{width:100%;margin-top:24rpx}.record-list{display:flex;flex-direction:column;gap:14rpx}.record-card{display:flex;align-items:flex-start;gap:18rpx;padding:23rpx;border:1rpx solid #e5ebf2;border-radius:20rpx;background:#fff}.record-mark{display:flex;align-items:center;justify-content:center;flex:none;width:54rpx;height:54rpx;border-radius:17rpx;background:#fff1ee;color:#d45943;font-size:21rpx;font-weight:800}.record-mark.income{background:#e8f8f1;color:#159366}.record-main{min-width:0;flex:1}.record-main text{display:block}.record-main text:first-child{overflow:hidden;color:#26364c;font-size:25rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.record-main text:nth-child(2),.record-main text:nth-child(3){margin-top:6rpx;color:#8592a3;font-size:19rpx}.record-amount{flex:none;color:#26364c;font-size:25rpx;font-weight:800}.record-amount.income{color:#159366}.empty-card{border:1rpx solid #e1e8f0;text-align:center}.empty-card text{display:block}.empty-card text:first-child{font-weight:700}.empty-card text:last-child{margin-top:10rpx;color:#8491a2;font-size:22rpx;line-height:1.6}
