.wallet-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.wallet-skeleton{height:350rpx}.balance-card{position:relative;overflow:hidden;padding:40rpx 34rpx 34rpx;border-radius:28rpx;background:linear-gradient(145deg,#0a4d9f,#1677ff 70%,#3aa2ff);box-shadow:0 20rpx 48rpx rgba(18,101,195,.22);color:#fff}.balance-label,.balance-value{display:block}.balance-label{font-size:23rpx;opacity:.75}.balance-value{margin:12rpx 0 32rpx;font-size:50rpx;font-weight:800;letter-spacing:1rpx}.balance-grid{display:grid;grid-template-columns:1fr 1fr;position:relative;z-index:1}.balance-grid view+view{padding-left:28rpx;border-left:1rpx solid rgba(255,255,255,.2)}.balance-grid text{display:block}.balance-grid text:first-child{font-size:20rpx;opacity:.68}.balance-grid text:last-child{margin-top:7rpx;font-size:27rpx;font-weight:700}.power-line{position:absolute;right:-14rpx;bottom:-12rpx;display:flex;align-items:flex-end;gap:8rpx;height:100rpx;opacity:.13}.power-line text{width:20rpx;border-radius:8rpx 8rpx 0 0;background:#fff}.power-line text:nth-child(1){height:32rpx}.power-line text:nth-child(2){height:58rpx}.power-line text:nth-child(3){height:44rpx}.power-line text:nth-child(4){height:86rpx}.power-line text:nth-child(5){height:68rpx}.recharge-note{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:22rpx 24rpx;border-radius:20rpx;background:#fff7e8}.recharge-note view text{display:block}.recharge-note view text:first-child{color:#8e5b0c;font-size:24rpx;font-weight:700}.recharge-note view text:last-child{margin-top:6rpx;color:#a47b3e;font-size:20rpx}.recharge-note>text{padding:7rpx 13rpx;border-radius:999rpx;background:#ffedc8;color:#ad6d08;font-size:19rpx}.section-caption{color:#8996a6;font-size:21rpx}.record-list{display:flex;flex-direction:column;gap:14rpx}.record-card{display:flex;align-items:flex-start;gap:18rpx;padding:23rpx;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(35,87,145,.05)}.record-mark{display:flex;align-items:center;justify-content:center;flex:none;width:54rpx;height:54rpx;border-radius:18rpx;background:#fff1ee;color:#d45943;font-size:21rpx;font-weight:800}.record-mark.income{background:#e8f8f1;color:#159366}.record-main{min-width:0;flex:1}.record-main text{display:block}.record-main text:first-child{overflow:hidden;font-size:25rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.record-main text:nth-child(2),.record-main text:nth-child(3){margin-top:6rpx;color:#8592a3;font-size:19rpx}.record-amount{flex:none;color:#26364c;font-size:25rpx;font-weight:800}.record-amount.income{color:#159366}.empty-card{text-align:center}.empty-card text{display:block}.empty-card text:first-child{font-weight:700}.empty-card text:last-child{margin-top:10rpx;color:#8491a2;font-size:22rpx;line-height:1.6}
