.model-intro{margin:-28rpx -28rpx 28rpx;padding:40rpx 32rpx 36rpx;background:linear-gradient(160deg,#eef6ff,#f8fbff 70%);border-bottom:1rpx solid #dce9f7}.intro-kicker,.intro-title,.intro-copy{display:block}.intro-kicker{color:#1677ff;font-size:19rpx;font-weight:800;letter-spacing:4rpx}.intro-title{margin:14rpx 0 10rpx;font-size:38rpx;font-weight:800}.intro-copy{color:#72839a;font-size:23rpx}
.search-row{display:flex;gap:14rpx}.search-box{display:flex;align-items:center;flex:1;height:80rpx;padding:0 24rpx;border:1rpx solid #dce7f3;border-radius:20rpx;background:#fff;box-sizing:border-box}.search-box>text{margin-right:14rpx;color:#1677ff;font-size:35rpx}.search-box input{flex:1}.filter-button{display:flex;align-items:center;justify-content:center;min-width:116rpx;height:80rpx;border-radius:20rpx;background:#fff;color:#50627a;font-weight:600}.filter-button.active{background:#1677ff;color:#fff}.filter-button text{margin-left:6rpx}.filter-popover{margin-top:14rpx}.filter-label{font-size:24rpx;font-weight:700}.filter-options{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}.filter-options text{padding:13rpx 20rpx;border-radius:14rpx;background:#f1f5fa;color:#607187;font-size:23rpx}.filter-options text.selected{background:#e5f1ff;color:#1677ff;font-weight:700}
.type-strip{width:100%;margin:24rpx 0}.type-items{display:flex;gap:12rpx;width:max-content;padding-right:28rpx}.type-chip{padding:14rpx 24rpx;border:1rpx solid #dce7f3;border-radius:999rpx;background:#fff;color:#65758a;font-size:24rpx;white-space:nowrap}.type-chip.active{border-color:#1677ff;background:#1677ff;color:#fff}
.model-list{display:flex;flex-direction:column;gap:18rpx}.model-card{display:flex;align-items:flex-start;gap:22rpx;padding:25rpx}.model-icon{position:relative;display:flex;align-items:center;justify-content:center;flex:none;width:88rpx;height:88rpx;overflow:hidden;border-radius:27rpx;background:linear-gradient(145deg,#1677ff,#7dc1ff);color:#fff;font-size:34rpx;font-weight:800}.icon-orbit{position:absolute;width:70rpx;height:22rpx;border:2rpx solid rgba(255,255,255,.38);border-radius:50%;transform:rotate(-30deg)}.model-body{min-width:0;flex:1}.model-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}.model-name{font-size:29rpx;font-weight:750;line-height:1.35}.status{flex:none;margin-top:3rpx;color:#8795a8;font-size:20rpx}.status.online{color:#15a66b}.model-description{display:-webkit-box;overflow:hidden;margin:10rpx 0 16rpx;color:#6e7e93;font-size:23rpx;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.model-tags{display:flex;flex-wrap:wrap;gap:8rpx}.model-tags .tag{min-height:36rpx;padding:0 12rpx;background:#f1f5f9;color:#607187;font-size:19rpx}.model-tags .type-tag{background:#eaf3ff;color:#0d5cbe}.arrow{align-self:center;color:#9aa7b7;font-size:42rpx}.model-skeleton{display:flex;gap:22rpx}.sk-icon{width:88rpx;height:88rpx;flex:none}.sk-body{flex:1}.sk-title{width:55%;height:26rpx}.sk-line{height:20rpx;margin-top:18rpx}.sk-line.short{width:72%}
