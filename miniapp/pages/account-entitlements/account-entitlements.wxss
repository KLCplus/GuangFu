.entitlement-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.entitlement-intro{padding:8rpx 4rpx 24rpx}.entitlement-intro text{display:block}.entitlement-intro text:first-child{color:#172033;font-size:38rpx;font-weight:800}.entitlement-intro text:last-child{margin-top:8rpx;color:#77879b;font-size:22rpx}.stats-card{display:grid;grid-template-columns:repeat(3,1fr);padding:25rpx 8rpx;border:1rpx solid #e1e8f0;border-radius:24rpx;background:#fff}.stats-card view{text-align:center}.stats-card view+view{border-left:1rpx solid #e9eef5}.stats-card text{display:block}.stats-card text:first-child{color:#1768b8;font-size:31rpx;font-weight:800}.stats-card text:last-child{margin-top:7rpx;color:#76859a;font-size:20rpx}.loading-caption{color:#8794a5;font-size:20rpx}.section-error{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:20rpx 22rpx;border-radius:18rpx;background:#fff0f2;color:#c43f53;font-size:21rpx}.section-error text:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.section-error text:last-child{flex:none;color:#1677ff;font-weight:700}.key-list,.benefit-list{display:flex;flex-direction:column;gap:14rpx}.key-card,.benefit-card{padding:24rpx;border:1rpx solid #e1e8f0;border-radius:20rpx;background:#fff}.key-head,.benefit-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.key-head>text:first-child{overflow:hidden;color:#26364c;font-size:26rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.key-status,.benefit-status{flex:none;padding:7rpx 12rpx;border-radius:999rpx;background:#f0f3f7;color:#7c8999;font-size:19rpx}.key-status.active,.benefit-status.active{background:#e8f8f1;color:#159366}.masked-key{display:block;overflow:hidden;margin:15rpx 0;color:#3f526a;font-family:monospace;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.key-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10rpx;color:#8996a6;font-size:19rpx}.benefit-head>view{min-width:0;flex:1}.benefit-head>view text{display:block}.benefit-head>view text:first-child{overflow:hidden;color:#26364c;font-size:27rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.benefit-head>view text:last-child{overflow:hidden;margin-top:7rpx;color:#7f8d9f;font-size:20rpx;text-overflow:ellipsis;white-space:nowrap}.quota-row,.benefit-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.quota-row{margin-top:23rpx;font-size:21rpx}.quota-row text:first-child{color:#66778d}.quota-row text:last-child{font-weight:700}.progress-track{height:10rpx;margin:12rpx 0;border-radius:999rpx;background:#eaf0f7}.progress-track view{height:100%;border-radius:999rpx;background:#1677ff}.benefit-foot{color:#8895a6;font-size:19rpx}.empty-card{border:1rpx solid #e1e8f0;box-shadow:none;text-align:center}.empty-card text{display:block}.empty-card text:first-child{font-weight:700}.empty-card text:last-child{margin-top:10rpx;color:#8491a2;font-size:22rpx;line-height:1.6}.safe-space{height:16rpx}
