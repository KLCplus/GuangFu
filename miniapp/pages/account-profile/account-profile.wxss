.account-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.profile-skeleton{height:360rpx}.avatar-card{display:flex;align-items:center;gap:20rpx;padding:28rpx;border:1rpx solid #e1e8f0;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(31,61,98,.04)}.avatar-large{display:flex;align-items:center;justify-content:center;flex:none;width:104rpx;height:104rpx;overflow:hidden;border:1rpx solid #cbdcf0;border-radius:32rpx;background:#eaf3ff;color:#1677ff;font-size:40rpx;font-weight:800}.avatar-large image{width:100%;height:100%}.avatar-copy{min-width:0;flex:1}.avatar-copy text{display:block}.avatar-copy text:first-child{overflow:hidden;color:#172033;font-size:29rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.avatar-copy text:last-child{margin-top:9rpx;color:#7b8ba0;font-size:19rpx}.avatar-button{min-width:112rpx;min-height:64rpx;padding:0 18rpx;border:1rpx solid #cfe0f4;background:#f2f7fd;color:#1768b8;font-size:22rpx}.form-card{padding-top:12rpx;border:1rpx solid #e1e8f0;box-shadow:none}.field-label{display:block;margin:25rpx 2rpx 10rpx;color:#4e6078;font-size:23rpx;font-weight:700}.field-input,.picker-field{width:100%;height:78rpx;padding:0 22rpx;border:1rpx solid #e3eaf2;border-radius:16rpx;background:#f7f9fc;box-sizing:border-box;font-size:26rpx}.field-hint{display:block;margin:8rpx 3rpx 0;color:#8a98aa;font-size:19rpx;line-height:1.5}.picker-field{display:flex;align-items:center;justify-content:space-between}.picker-field text{color:#8794a6}.readonly-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:18rpx 2rpx 24rpx;border-bottom:1rpx solid #edf2f7}.readonly-row text:first-child{color:#67778d;font-size:23rpx}.readonly-row text:last-child{overflow:hidden;max-width:440rpx;color:#26364c;font-weight:650;text-overflow:ellipsis;white-space:nowrap}.save-button{width:100%;margin-top:34rpx}.read-note{margin-top:20rpx;padding:0 8rpx;color:#8a97a8;font-size:21rpx;line-height:1.6}
