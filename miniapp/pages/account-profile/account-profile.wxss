.account-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.profile-skeleton{height:360rpx}.avatar-card{display:flex;align-items:center;gap:20rpx;padding:28rpx;border-radius:26rpx;background:linear-gradient(145deg,#0d5dbd,#278af2);box-shadow:0 18rpx 42rpx rgba(22,119,255,.18);color:#fff}.avatar-large{display:flex;align-items:center;justify-content:center;flex:none;width:104rpx;height:104rpx;overflow:hidden;border:3rpx solid rgba(255,255,255,.4);border-radius:36rpx;background:rgba(255,255,255,.16);font-size:40rpx;font-weight:800}.avatar-large image{width:100%;height:100%}.avatar-copy{min-width:0;flex:1}.avatar-copy text{display:block}.avatar-copy text:first-child{overflow:hidden;font-size:29rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.avatar-copy text:last-child{margin-top:9rpx;font-size:19rpx;opacity:.75}.avatar-button{min-width:112rpx;min-height:64rpx;padding:0 18rpx;background:rgba(255,255,255,.16);color:#fff;font-size:22rpx}.avatar-delete{padding:18rpx 8rpx 0;color:#d94b5e;font-size:22rpx;text-align:right}.form-card{padding-top:12rpx}.field-label{display:block;margin:25rpx 2rpx 10rpx;color:#4e6078;font-size:23rpx;font-weight:700}.field-input,.picker-field{width:100%;height:78rpx;padding:0 22rpx;border-radius:17rpx;background:#f2f6fb;box-sizing:border-box;font-size:26rpx}.field-hint{display:block;margin:8rpx 3rpx 0;color:#929eae;font-size:19rpx;line-height:1.5}.picker-field{display:flex;align-items:center;justify-content:space-between}.picker-field text{color:#8794a6}.readonly-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:18rpx 2rpx 24rpx;border-bottom:1rpx solid #edf2f7}.readonly-row text:first-child{color:#67778d;font-size:23rpx}.readonly-row text:last-child{overflow:hidden;max-width:440rpx;font-weight:650;text-overflow:ellipsis;white-space:nowrap}.save-button{width:100%;margin-top:34rpx}.read-note{margin-top:20rpx;padding:0 8rpx;color:#8a97a8;font-size:21rpx;line-height:1.6}
