.overview-hero { position: relative; overflow: hidden; margin: -28rpx -28rpx 32rpx; padding: 34rpx 36rpx 38rpx; background: linear-gradient(145deg, #0b4eaa 0%, #1677ff 62%, #52a9ff 100%); color: #fff; }
.hero-top,.key-name-row,.log-main>view { display:flex; align-items:center; justify-content:space-between; }
.hero-kicker { font-size: 19rpx; font-weight:700; letter-spacing:4rpx; opacity:.78; }.hero-range { padding:8rpx 16rpx; border:1rpx solid rgba(255,255,255,.28); border-radius:999rpx; font-size:21rpx; }
.hero-title { margin-top:26rpx; font-size:40rpx; font-weight:800; letter-spacing:1rpx; }.pulse-line { display:flex; align-items:center; margin:25rpx 0 30rpx; }.pulse-dot { width:13rpx;height:13rpx;border:7rpx solid rgba(255,255,255,.28);border-radius:50%;background:#fff; }.pulse-track { flex:1;height:2rpx;background:linear-gradient(90deg,rgba(255,255,255,.85),rgba(255,255,255,.05)); }
.hero-metrics { display:grid; grid-template-columns:repeat(3,1fr); gap:12rpx; }.hero-metrics>view { padding:16rpx 18rpx; border-radius:17rpx; background:rgba(255,255,255,.12); }.hero-value,.hero-label { display:block; }.hero-value{font-size:29rpx;font-weight:750;}.hero-label{margin-top:5rpx;font-size:20rpx;opacity:.76;}
.login-state{margin-top:48rpx}.loading-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.loading-block{height:180rpx}.loading-wide{height:230rpx;margin-top:22rpx}
.wallet-card{padding:0;overflow:hidden}.wallet-main{padding:32rpx;background:linear-gradient(140deg,#0d4fa8,#1677ff);color:#fff}.wallet-label,.wallet-frozen{display:block;font-size:22rpx;opacity:.75}.wallet-amount{display:block;margin:10rpx 0 8rpx;font-size:52rpx;font-weight:800}.wallet-side{display:flex;justify-content:space-between;padding:24rpx 30rpx;border-bottom:1rpx solid #e5edf6;color:#61728a}.wallet-side text:last-child{color:#172033;font-weight:700}.wallet-records{padding:4rpx 28rpx 12rpx}.wallet-record{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #edf2f7}.wallet-record:last-child{border:0}.wallet-record view text{display:block}.wallet-record view text:last-child{margin-top:6rpx;color:#8a98aa;font-size:21rpx}.record-amount{font-weight:700}
.key-list{display:flex;flex-direction:column;gap:16rpx}.key-card{display:flex;align-items:flex-start;gap:20rpx}.key-status{width:13rpx;height:13rpx;margin-top:10rpx;border-radius:50%;background:#aeb9c7;box-shadow:0 0 0 8rpx #eff2f6}.key-status.is-active{background:#15a66b;box-shadow:0 0 0 8rpx #e5f7ef}.key-body{min-width:0;flex:1}.key-name{font-weight:700}.key-state{font-size:22rpx}.key-mask,.key-meta{display:block}.key-mask{margin:11rpx 0 8rpx;color:#37516f;font-family:monospace;font-size:24rpx}.key-meta{color:#8a98aa;font-size:21rpx}.key-more{color:#8594a8;letter-spacing:1rpx}
.section-caption{color:#8a98aa;font-size:22rpx}.trend-card{padding-bottom:20rpx}.trend-bars{display:flex;align-items:flex-end;height:180rpx;gap:7rpx;padding:18rpx 4rpx 0}.trend-item{display:flex;flex:1;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;color:#8a98aa;font-size:17rpx}.trend-value{margin-bottom:5rpx;color:#49617e;font-size:17rpx}.trend-bar{width:66%;min-height:8rpx;margin-bottom:8rpx;border-radius:8rpx 8rpx 2rpx 2rpx;background:linear-gradient(180deg,#58afff,#1677ff)}.token-note{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #edf2f7;color:#7b8ba0;font-size:22rpx}
.log-list{padding-top:8rpx;padding-bottom:8rpx}.log-item{display:flex;gap:18rpx;padding:23rpx 0;border-bottom:1rpx solid #edf2f7}.log-item:last-child{border:0}.log-dot{width:13rpx;height:13rpx;margin-top:10rpx;border-radius:50%}.log-dot.ok{background:#15a66b}.log-dot.fail{background:#df4b5f}.log-main{min-width:0;flex:1}.log-model{font-weight:700}.log-cost{color:#61728a;font-size:22rpx}.log-path,.log-time,.log-error{display:block}.log-path{margin:7rpx 0;color:#50627a;font-family:monospace;font-size:22rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.log-time{color:#94a0b0;font-size:20rpx}.log-error{margin-top:8rpx;color:#df4b5f;font-size:21rpx}
.inline-error{display:flex;justify-content:space-between;color:#df4b5f;font-size:24rpx}.inline-error text:last-child{color:#1677ff}.compact-empty,.compact-error{padding:38rpx 24rpx;color:#8391a4;text-align:center;font-size:24rpx}.compact-error{color:#df4b5f}
