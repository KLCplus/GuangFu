.news-head{display:flex;align-items:flex-end;justify-content:space-between;margin:8rpx 2rpx 28rpx}.news-kicker,.news-title{display:block}.news-kicker{color:#1677ff;font-size:19rpx;font-weight:800;letter-spacing:4rpx}.news-title{margin-top:8rpx;font-size:44rpx;font-weight:800}.unread-badge{min-width:50rpx;height:50rpx;padding:0 12rpx;border-radius:18rpx;background:#df4b5f;color:#fff;font-size:22rpx;font-weight:700;line-height:50rpx;text-align:center;box-sizing:border-box}.tab-switch{display:grid;grid-template-columns:1fr 1fr;padding:6rpx;border-radius:20rpx;background:#e8eff7}.tab-switch view{height:68rpx;border-radius:16rpx;color:#74849a;line-height:68rpx;text-align:center}.tab-switch view.active{background:#fff;color:#172033;font-weight:700;box-shadow:0 5rpx 14rpx rgba(47,85,126,.08)}.tab-switch text{display:inline-block;min-width:30rpx;height:30rpx;margin-left:8rpx;border-radius:999rpx;background:#df4b5f;color:#fff;font-size:18rpx;line-height:30rpx}
.search-box{display:flex;align-items:center;height:78rpx;margin-top:22rpx;padding:0 24rpx;border:1rpx solid #dce7f3;border-radius:20rpx;background:#fff;box-sizing:border-box}.search-box>text{margin-right:14rpx;color:#1677ff;font-size:34rpx}.search-box input{flex:1}.type-strip{width:100%;margin:20rpx 0}.type-items{display:flex;gap:10rpx;width:max-content;padding-right:28rpx}.type-chip{padding:12rpx 22rpx;border-radius:999rpx;background:#fff;color:#68798f;font-size:23rpx;white-space:nowrap}.type-chip.active{background:#1677ff;color:#fff}
.news-list{display:flex;flex-direction:column;gap:17rpx}.news-card{position:relative;overflow:hidden}.news-card::before{position:absolute;left:0;top:0;bottom:0;width:6rpx;background:#1677ff;content:""}.news-card.is-alert::before{background:#df4b5f}.news-meta{display:flex;align-items:center;justify-content:space-between;color:#8b98aa;font-size:21rpx}.news-type{color:#1677ff;font-weight:700}.is-alert .news-type{color:#df4b5f}.item-title,.item-summary{display:block}.item-title{margin:16rpx 0 10rpx;font-size:30rpx;font-weight:750;line-height:1.45}.item-summary{display:-webkit-box;overflow:hidden;color:#68798f;font-size:23rpx;line-height:1.65;-webkit-box-orient:vertical;-webkit-line-clamp:2}.read-row{display:flex;justify-content:space-between;margin-top:19rpx;padding-top:16rpx;border-top:1rpx solid #edf2f7;color:#1677ff;font-size:22rpx}.load-more{padding:20rpx;color:#8a98aa;text-align:center;font-size:22rpx}.news-skeleton{height:210rpx}.sk-label{width:20%;height:20rpx}.sk-title{width:78%;height:30rpx;margin-top:26rpx}.sk-copy{height:44rpx;margin-top:20rpx}
.source-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:14rpx;color:#8391a4;font-size:20rpx}.source-row text:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-row text:last-child{flex:none;padding:4rpx 10rpx;border-radius:999rpx;background:#fff3e6;color:#b56816}
.notice-login{margin-top:26rpx}.notice-tools{display:flex;align-items:center;justify-content:space-between;margin:24rpx 2rpx 16rpx;color:#1677ff;font-size:23rpx}.filter-pill{padding:12rpx 20rpx;border-radius:999rpx;background:#fff;color:#66778d}.filter-pill.active{background:#e6f2ff;color:#1677ff}.notice-list{padding-top:4rpx;padding-bottom:4rpx}.notice-item{display:flex;gap:18rpx;padding:25rpx 0;border-bottom:1rpx solid #edf2f7}.notice-item:last-child{border:0}.notice-dot{flex:none;width:12rpx;height:12rpx;margin-top:10rpx;border-radius:50%;background:#c8d1dc}.notice-dot.unread{background:#1677ff;box-shadow:0 0 0 7rpx #e6f2ff}.notice-main{min-width:0;flex:1}.notice-main>view{display:flex;justify-content:space-between;gap:12rpx}.notice-main>view>text:last-child{flex:none;color:#94a0b0;font-size:20rpx}.notice-title{font-weight:700}.notice-content,.notice-state{display:block}.notice-content{margin:9rpx 0;color:#62738a;font-size:23rpx;line-height:1.6}.notice-state{color:#9aa6b6;font-size:20rpx}
.notice-type-strip{margin-top:0}.notice-kind{display:block;margin-top:8rpx;color:#1677ff;font-size:20rpx}.notice-title{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
