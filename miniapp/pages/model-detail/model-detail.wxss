.detail-page{padding-top:0}.detail-hero{margin:0 -28rpx 26rpx;padding:46rpx 34rpx 42rpx;background:linear-gradient(145deg,#0b4eaa,#1677ff);color:#fff}.hero-code{font-family:monospace;font-size:20rpx;letter-spacing:3rpx;opacity:.7}.hero-title{margin:18rpx 0;font-size:42rpx;font-weight:800}.hero-meta{display:flex;gap:14rpx;align-items:center}.hero-meta text{padding:8rpx 14rpx;border-radius:999rpx;background:rgba(255,255,255,.12);font-size:21rpx}.hero-meta .online{background:rgba(58,211,151,.2)}.description-card,.config-card,.list-card,.placeholder-card{margin-bottom:18rpx}.block-title{display:block;margin-bottom:18rpx;font-size:29rpx;font-weight:750}.description{color:#5f7088;line-height:1.8}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:22rpx}.config-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.config-grid view{padding:20rpx;border-radius:17rpx;background:#f5f8fc}.config-grid text{display:block}.config-grid text:first-child{color:#7d8da2;font-size:21rpx}.config-grid text:last-child{margin-top:6rpx;font-weight:700}.bullet{display:flex;gap:14rpx;margin:14rpx 0;color:#5e7088;line-height:1.55}.bullet>text:first-child{flex:none;width:9rpx;height:9rpx;margin-top:17rpx;border-radius:50%;background:#1677ff}.placeholder-card{display:flex;align-items:center;justify-content:space-between}.placeholder-card>view text{display:block}.placeholder-card>view text:first-child{font-weight:700}.placeholder-card>view text:last-child{margin-top:7rpx;color:#8391a4;font-size:22rpx}.placeholder-card button{min-height:64rpx;font-size:23rpx}.detail-loading{height:300rpx}
