.security-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.page-heading{padding:8rpx 4rpx 24rpx}.page-heading text{display:block}.page-heading text:first-child{color:#172033;font-size:38rpx;font-weight:800}.page-heading text:last-child{margin-top:8rpx;color:#77879b;font-size:22rpx}.status-skeleton{height:350rpx}.status-card{padding:8rpx 26rpx;border:1rpx solid #e1e8f0;box-shadow:none}.binding-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:14rpx;padding:25rpx 0;border-bottom:1rpx solid #edf2f7}.binding-copy{min-width:0}.binding-copy text{display:block}.binding-copy text:first-child{color:#26364c;font-size:25rpx;font-weight:700}.binding-copy text:last-child{overflow:hidden;margin-top:7rpx;color:#7d8ca0;font-size:20rpx;text-overflow:ellipsis;white-space:nowrap}.binding-tag{padding:6rpx 12rpx;border-radius:999rpx;background:#f1f4f8;color:#718096;font-size:18rpx}.binding-tag.bound{background:#e8f8f1;color:#16865f}.row-action{min-width:82rpx;height:54rpx;padding:0 16rpx;border:1rpx solid #cfe0f4;border-radius:14rpx;background:#f2f7fd;color:#1768b8;font-size:20rpx;line-height:52rpx}.row-action::after{border:0}.binding-note{padding:20rpx 0;color:#8a98aa;font-size:19rpx;line-height:1.6}.operation-shell{margin-top:30rpx}.operation-head{display:flex;align-items:flex-end;justify-content:space-between;padding:0 4rpx 14rpx}.operation-head view text{display:block}.operation-head view text:first-child{color:#172033;font-size:29rpx;font-weight:760}.operation-head view text:last-child{margin-top:6rpx;color:#8492a4;font-size:19rpx}.operation-head>text{color:#1677ff;font-size:21rpx}.operation-card{padding-top:12rpx;border:1rpx solid #e1e8f0;box-shadow:none}.field-label{display:block;margin:25rpx 2rpx 10rpx;color:#4e6078;font-size:23rpx;font-weight:700}.field-input{width:100%;height:78rpx;padding:0 22rpx;border:1rpx solid #e3eaf2;border-radius:16rpx;background:#f7f9fc;box-sizing:border-box;font-size:26rpx}.field-hint{display:block;margin:10rpx 3rpx 0;color:#8a98aa;font-size:19rpx;line-height:1.5}.email-code-row{display:grid;grid-template-columns:minmax(0,1fr) 190rpx;gap:14rpx;margin-top:20rpx}.email-code-row .button-quiet{height:78rpx;padding:0 10rpx;font-size:21rpx}.operation-button{width:100%;margin-top:32rpx}.security-footnote{margin-top:22rpx;padding:0 8rpx;color:#8a97a8;font-size:20rpx;line-height:1.6}
