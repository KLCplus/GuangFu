.security-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.security-intro{margin:-28rpx -28rpx 26rpx;padding:42rpx 34rpx 38rpx;background:linear-gradient(145deg,#0b4eaa,#1677ff);color:#fff}.security-intro text{display:block}.security-intro text:first-child{font-size:38rpx;font-weight:800}.security-intro text:last-child{margin-top:10rpx;font-size:23rpx;opacity:.76}.status-card{padding-top:8rpx;padding-bottom:8rpx}.status-skeleton{height:180rpx}.binding-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:23rpx 0}.binding-row+.binding-row{border-top:1rpx solid #edf2f7}.binding-row>view{min-width:0;flex:1}.binding-row>view text{display:block}.binding-row>view text:first-child{font-size:25rpx;font-weight:700}.binding-row>view text:last-child{overflow:hidden;margin-top:7rpx;color:#78879a;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.binding-tag{flex:none;padding:8rpx 14rpx;border-radius:999rpx;background:#f1f4f8;color:#7f8c9d;font-size:20rpx}.binding-tag.bound{background:#e8f8f1;color:#159366}.binding-note{margin:8rpx 0 18rpx;padding:16rpx 18rpx;border-radius:14rpx;background:#f4f7fb;color:#7c899a;font-size:20rpx;line-height:1.6}.field-label{display:block;margin:22rpx 2rpx 10rpx;color:#4e6078;font-size:23rpx;font-weight:700}.field-label:first-child{margin-top:0}.field-input{height:78rpx;padding:0 22rpx;border-radius:17rpx;background:#f2f6fb;font-size:26rpx}.field-hint{display:block;margin:12rpx 2rpx;color:#7c899a;font-size:21rpx;line-height:1.55}.email-code-row{display:grid;grid-template-columns:minmax(0,1fr) 188rpx;gap:16rpx;align-items:center;margin-top:22rpx}.email-code-row .button-quiet{width:100%;margin:0}.password-button{width:100%;margin-top:34rpx}.security-footnote{margin-top:20rpx;padding:0 8rpx;color:#8b98a9;font-size:21rpx;text-align:center}
