<view class="page security-page">
  <view class="page-heading"><text>安全与登录</text><text>敏感操作仅在你主动发起后显示</text></view>

  <view wx:if="{{loading}}" class="card status-card"><view class="skeleton status-skeleton"></view></view>
  <view wx:elif="{{error}}" class="card state-card"><view class="state-mark">!</view><view class="state-title">安全信息加载失败</view><view class="state-copy">{{error}}</view><button class="button-quiet" bindtap="loadProfile">重新加载</button></view>
  <block wx:elif="{{profile}}">
    <view class="card status-card">
      <view class="binding-row">
        <view class="binding-copy"><text>登录邮箱</text><text>{{profile.email || '未绑定邮箱'}}</text></view>
        <text class="binding-tag {{profile.emailVerified ? 'bound' : ''}}">{{profile.email ? (profile.emailVerified ? '已验证' : '未验证') : '未绑定'}}</text>
        <button class="row-action" data-action="email" bindtap="toggleAction">{{profile.email ? '更换' : '绑定'}}</button>
      </view>
      <view class="binding-row">
        <view class="binding-copy"><text>联系手机号</text><text>{{profile.phone || '未填写'}}</text></view>
        <text class="binding-tag {{profile.phoneVerified ? 'bound' : ''}}">{{profile.phoneVerified ? '已验证' : (profile.phone ? '未验证' : '未填写')}}</text>
        <button class="row-action" bindtap="goProfile">{{profile.phone ? '查看' : '完善'}}</button>
      </view>
      <view class="binding-row">
        <view class="binding-copy"><text>登录密码</text><text>通过当前密码验证后可修改</text></view>
        <text class="binding-tag bound">受保护</text>
        <button class="row-action" data-action="password" bindtap="toggleAction">修改</button>
      </view>
      <view class="binding-note">手机号当前仅作为联系方式；未接入短信验证、验证码登录或密码找回。</view>
    </view>

    <view wx:if="{{activeAction === 'email'}}" class="operation-shell">
      <view class="operation-head"><view><text>{{profile.email ? '更换邮箱' : '绑定邮箱'}}</text><text>验证码通过前，原邮箱保持不变</text></view><text data-action="email" bindtap="toggleAction">收起</text></view>
      <view class="card operation-card">
        <text class="field-label">新邮箱</text>
        <input class="field-input" value="{{emailForm.newEmail}}" disabled="{{emailCodeSent}}" maxlength="128" placeholder="name@example.com" bindinput="onNewEmail" />
        <text class="field-label">当前密码</text>
        <input class="field-input" password value="{{emailForm.currentPassword}}" placeholder="请输入当前密码" bindinput="onEmailPassword" />
        <view class="email-code-row">
          <input class="field-input" value="{{emailForm.code}}" maxlength="8" placeholder="邮箱验证码" bindinput="onEmailCode" />
          <button class="button-quiet" loading="{{emailSending}}" disabled="{{emailSending || emailCountdown > 0}}" bindtap="sendEmailCode">{{emailCountdown > 0 ? emailCountdown + 's' : (emailCodeSent ? '重发' : '发送验证码')}}</button>
        </view>
        <text wx:if="{{emailCodeSent}}" class="field-hint">验证码已发送，此时邮箱尚未改变。</text>
        <button class="button-primary operation-button" loading="{{emailConfirming}}" disabled="{{emailConfirming || !emailCodeSent}}" bindtap="confirmEmailChange">验证并更新邮箱</button>
      </view>
    </view>

    <view wx:if="{{activeAction === 'password'}}" class="operation-shell">
      <view class="operation-head"><view><text>修改密码</text><text>修改成功后需要使用新密码重新登录</text></view><text data-action="password" bindtap="toggleAction">收起</text></view>
      <view class="card operation-card">
        <text class="field-label">原密码</text>
        <input class="field-input" password value="{{form.oldPassword}}" placeholder="请输入原密码" bindinput="onOldPassword" />
        <text class="field-label">新密码</text>
        <input class="field-input" password value="{{form.newPassword}}" maxlength="64" placeholder="8–64 位" bindinput="onNewPassword" />
        <text class="field-label">确认新密码</text>
        <input class="field-input" password value="{{form.confirmPassword}}" maxlength="64" placeholder="再次输入新密码" bindinput="onConfirmPassword" confirm-type="done" bindconfirm="changePassword" />
        <button class="button-primary operation-button" loading="{{saving}}" disabled="{{saving}}" bindtap="changePassword">{{saving ? '正在修改' : '确认修改密码'}}</button>
      </view>
    </view>
  </block>
  <view class="security-footnote">密码不会写入本地存储，也不会输出到日志。</view>
</view>
