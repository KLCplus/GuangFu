page {
  --brand: #1677ff;
  --brand-deep: #0d4fa8;
  --brand-soft: #eaf3ff;
  --ink: #172033;
  --muted: #6f7f96;
  --line: #e5edf6;
  --surface: #ffffff;
  --success: #15a66b;
  --warning: #d88a12;
  --danger: #df4b5f;
  background: #f5f7fa;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.card {
  padding: 28rpx;
  background: var(--surface);
  border: 1rpx solid #e1e8f0;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(34, 59, 88, 0.05);
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 2rpx 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.section-action {
  color: var(--brand);
  font-size: 24rpx;
}

.muted { color: var(--muted); }
.success { color: var(--success); }
.danger { color: var(--danger); }

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 22rpx;
  box-sizing: border-box;
}

.button-primary,
.button-quiet {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1;
}

.button-primary {
  background: var(--brand);
  color: #fff;
}

.button-quiet {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.button-primary::after,
.button-quiet::after { border: 0; }

.state-card {
  padding: 70rpx 34rpx;
  text-align: center;
}

.state-mark {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 22rpx;
  border-radius: 24rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.state-title { font-size: 30rpx; font-weight: 700; }
.state-copy { margin: 12rpx 0 28rpx; color: var(--muted); font-size: 25rpx; line-height: 1.65; }

.skeleton {
  overflow: hidden;
  position: relative;
  background: #eaf0f7;
  border-radius: 12rpx;
}

.skeleton::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.75), transparent);
  content: "";
  animation: shimmer 1.2s infinite;
}

@keyframes shimmer {
  from { transform: translateX(-100%); }
  to { transform: translateX(100%); }
}
