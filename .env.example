# PV Platform single local configuration template.
# start-local.ps1 copies this file to .env and fills safe local defaults.
# Do not paste private keys into this file. Put QWeather PEM files under backend/secrets/.

# Docker MySQL
MYSQL_ROOT_PASSWORD=change-me

# Server
SERVER_PORT=8080
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=10
TOMCAT_MAX_CONNECTIONS=8192
TOMCAT_ACCEPT_COUNT=100

# Database
MYSQL_URL=jdbc:mysql://localhost:3306/pv_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
MYSQL_POOL_MAX_SIZE=10
MYSQL_POOL_MIN_IDLE=2

# JWT
JWT_SECRET=change-me-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRATION=7200
JWT_REFRESH_TOKEN_EXPIRATION=604800

# Redis and cache
REDIS_ENABLED=false
CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=3000
CACHE_REDIS_TTL=600000

# Model service
MODEL_SERVICE_BASE_URL=http://localhost:9000

# Weather
WEATHER_PROVIDER=LOCAL
WEATHER_AUTH_TYPE=JWT
WEATHER_API_KEY=
WEATHER_BASE_URL=https://your-qweather-api-host
WEATHER_CONNECT_TIMEOUT=3000
WEATHER_RESPONSE_TIMEOUT=5000
WEATHER_CACHE_MINUTES=10
WEATHER_FORECAST_DAYS=3
WEATHER_JWT_TTL_SECONDS=1800
QWEATHER_PROJECT_ID=
QWEATHER_KEY_ID=
QWEATHER_PRIVATE_KEY_PATH=.\secrets\ed25519-private.pem

# Login and verification code limits
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
VERIFY_CODE_EXPIRE_MINUTES=5
VERIFY_CODE_LENGTH=6
VERIFY_CODE_MAX_ATTEMPTS=5
VERIFY_CODE_RESEND_COOLDOWN_SECONDS=60
VERIFY_CODE_MAX_DAILY_SENDS=20

# Mail
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SSL_ENABLED=true

# OAuth
OAUTH_CALLBACK_BASE_URL=http://localhost:5173
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Face recognition
FACE_PROVIDER=local
FACE_MATCH_THRESHOLD=75
FACE_TEMP_URL_EXPIRE_SECONDS=300
FACE_STORAGE_DIR=./data/faces
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_FACE_REGION=cn-shanghai
ALIYUN_FACE_ENDPOINT=facebody.cn-shanghai.aliyuncs.com
ALIYUN_FACE_DB_NAME=pv_platform
ALIYUN_OSS_REGION=cn-shanghai
ALIYUN_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_BUCKET=

# File storage
AVATAR_STORAGE_DIR=./data/avatars
AVATAR_MAX_SIZE=2097152
PV_IMPORT_STORAGE_DIR=./data/pv-imports
PV_IMPORT_MAX_FILE_SIZE=10485760
PV_IMPORT_MAX_ROWS=100000
